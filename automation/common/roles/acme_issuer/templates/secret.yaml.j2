# Única fuente de credenciales ACME; no publicar el render de este archivo.
apiVersion: v1
kind: Secret
metadata:
  name: {{ acme_secret_nombre | to_json }}
  namespace: {{ acme_secret_namespace | to_json }}
  labels:
    workshop.module: connectivity-link
    workshop.component: acme-issuer
{% if acme_issuer_participant_mode | default(false) %}
    workshop.user: {{ lab_id | to_json }}
{% endif %}
type: Opaque
data:
  AWS_ACCESS_KEY_ID: {{ dns_provider_datos.AWS_ACCESS_KEY_ID | b64encode | to_json }}
  AWS_SECRET_ACCESS_KEY: {{ dns_provider_datos.AWS_SECRET_ACCESS_KEY | b64encode | to_json }}
