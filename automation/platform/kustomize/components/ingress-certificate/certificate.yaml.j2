apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: cl-ingress-tls
  namespace: openshift-ingress
spec:
  secretName: cl-ingress-tls
  dnsNames:
    - {{ ingress_domain | to_json }}
    - {{ ('*.' ~ ingress_domain) | to_json }}
  issuerRef:
    group: cert-manager.io
    kind: Issuer
    name: cl-ingress-acme
  privateKey:
    algorithm: RSA
    size: 2048
    rotationPolicy: Always
