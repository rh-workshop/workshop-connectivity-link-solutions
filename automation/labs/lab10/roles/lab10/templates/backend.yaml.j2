# Lab 10 · paso 2: el programa en un ConfigMap y dos Deployments (v1 y v2) que
# solo cambian API_VERSION. Devuelve versión, método, path y cabeceras x-*.
apiVersion: v1
kind: ConfigMap
metadata:
  name: gobierno-api-src
  namespace: {{ wk_ns_app }}
  labels:
    workshop.user: {{ lab_id }}
data:
  server.py: |
    {{ lookup('ansible.builtin.file', role_path ~ '/../../../../common/roles/comun/files/http-echo-server.py') | indent(4) }}
{% for v in ['v1', 'v2'] %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gobierno-api-{{ v }}
  namespace: {{ wk_ns_app }}
  labels:
    app: gobierno-api-{{ v }}
    workshop.user: {{ lab_id }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gobierno-api-{{ v }}
  template:
    metadata:
      labels:
        app: gobierno-api-{{ v }}
    spec:
      volumes:
        - name: src
          configMap:
            name: gobierno-api-src
      containers:
        - name: api
          image: {{ lab10_imagen }}
          command: ["python", "/opt/app/server.py"]
          env:
            - name: API_VERSION
              value: "{{ v }}"
          volumeMounts:
            - name: src
              mountPath: /opt/app
          ports:
            - name: http
              containerPort: 8080
          resources:
            requests: { cpu: 50m, memory: 64Mi }
            limits: { cpu: 200m, memory: 128Mi }
---
apiVersion: v1
kind: Service
metadata:
  name: gobierno-api-{{ v }}
  namespace: {{ wk_ns_app }}
  labels:
    app: gobierno-api-{{ v }}
    workshop.user: {{ lab_id }}
spec:
  selector:
    app: gobierno-api-{{ v }}
  ports:
    - name: http
      port: 8080
      targetPort: 8080
{% endfor %}
