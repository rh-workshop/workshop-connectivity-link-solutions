# Lab 10 · paso 7 (estado final): x-api-version: v2 fuerza v2; el resto se
# reparte {{ lab10_peso_v1 }}/{{ lab10_peso_v2 }}. El aviso de retirada va en el
# backendRef de v1: solo las respuestas de v1 llevan Deprecation, Sunset y Link.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: gobierno-route-{{ lab_id }}
  namespace: {{ wk_ns_app }}
  labels:
    workshop.user: {{ lab_id }}
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ wk_gateway }}
      namespace: {{ wk_ns_gateway }}
  hostnames:
    - {{ wk_lab_host }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /gobierno
          headers:
            - name: x-api-version
              value: v2
      backendRefs:
        - name: gobierno-api-v2
          port: 8080
    - matches:
        - path:
            type: PathPrefix
            value: /gobierno
      backendRefs:
        - name: gobierno-api-v1
          port: 8080
          weight: {{ lab10_peso_v1 }}
          filters:
            - type: ResponseHeaderModifier
              responseHeaderModifier:
                add:
                  - name: Deprecation
                    value: "true"
                  - name: Sunset
                    value: "{{ lab10_sunset }}"
                  - name: Link
                    value: '<https://{{ wk_lab_host }}/gobierno/v2/saldo>; rel="successor-version"'
        - name: gobierno-api-v2
          port: 8080
          weight: {{ lab10_peso_v2 }}
