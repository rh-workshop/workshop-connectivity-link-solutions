# HTTPRoute del participante: parentRef al Gateway {{ lab_id }}, todo el path a bank-api:8080.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: api-route-{{ lab_id }}
  namespace: {{ wk_ns_app }}
  labels:
    workshop.user: {{ lab_id }}
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ wk_gateway }}
      namespace: {{ wk_ns_gateway }}
  hostnames:
    - {{ wk_lab_host }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: bank-api
          port: 8080
