# Lab 9 · paso 2: una regla Exact por mapping rule bajo /3scale, con las
# políticas headers (X-Api-Version) y cors de APIcast como filtros; la tercera
# regla cierra el prefijo (lo no mapeado responde 404 del backend).
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: bank-3scale-route-{{ lab_id }}
  namespace: {{ wk_ns_app }}
  labels:
    workshop.user: {{ lab_id }}
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ wk_gateway }}
      namespace: {{ wk_ns_gateway }}
  hostnames:
    - {{ wk_lab_host }}
  rules:
{% for regla in ['/api/v1/accounts', '/api/v1/party'] %}
    # Mapping rule {{ loop.index }} · GET {{ regla }}
    - matches:
        - method: GET
          path:
            type: Exact
            value: /3scale{{ regla }}
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplaceFullPath
              replaceFullPath: {{ regla }}
        - type: RequestHeaderModifier
          requestHeaderModifier:
            add:
              - name: X-Api-Version
                value: v1
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            add:
              - name: Access-Control-Allow-Origin
                value: "*"
              - name: Access-Control-Allow-Methods
                value: GET
              - name: Access-Control-Allow-Headers
                value: user-key
      backendRefs:
        - name: bank-api
          port: 8080
{% endfor %}
    # Sin mapping rule: cualquier otro path bajo /3scale no se expone
    - matches:
        - path:
            type: PathPrefix
            value: /3scale
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplaceFullPath
              replaceFullPath: /no-mapping-rule
      backendRefs:
        - name: bank-api
          port: 8080
