# Lab 9 · pasos 3 y «planes»: una Application de 3scale = un Secret con su
# user_key original; app y plan viajan en anotaciones que exporta la AuthPolicy.
apiVersion: v1
kind: Secret
metadata:
  name: {{ item.app }}-{{ lab_id }}
  namespace: {{ wk_ns_app }}
  labels:
    authorino.kuadrant.io/managed-by: authorino
    kuadrant.io/3scale-product: bank-api-{{ lab_id }}
    workshop.user: {{ lab_id }}
  annotations:
    secret.kuadrant.io/app: {{ item.app }}
    secret.kuadrant.io/plan: {{ item.plan }}
{% if item.plan_id is defined %}
    secret.kuadrant.io/plan-id: {{ item.plan_id }}
{% endif %}
type: Opaque
stringData:
  api_key: k-{{ item.plan }}-{{ lab_id }}
