# API key del consumidor (https://rh-workshop.github.io/workshop-connectivity-link/lab4-api-key.html), en el
# mismo namespace que la AuthPolicy de ruta. Las labels la hacen visible a
# Authorino; las anotaciones aportan identidad y rol.
apiVersion: v1
kind: Secret
metadata:
  name: api-key-{{ lab_id }}
  namespace: {{ wk_ns_app }}
  labels:
    app: bank-api
    workshop.user: {{ lab_id }}
    kuadrant.io/auth-secret: "true"
    # Authorino solo vigila Secrets con esta etiqueta: sin ella no carga la
    # clave y la petición se rechaza con 401 aunque la clave sea correcta.
    authorino.kuadrant.io/managed-by: authorino
  annotations:
    secret.kuadrant.io/user-id: {{ lab_id }}
    secret.kuadrant.io/role: "{{ lab04b_rol }}"
type: Opaque
stringData:
  api_key: "{{ wk_lab04b_api_key }}"
