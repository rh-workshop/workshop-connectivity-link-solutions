# Mock LLM que responde con formato OpenAI (usage.total_tokens): ia-practica.adoc,
# paso 1 (https://rh-workshop.github.io/workshop-connectivity-link/ia-practica.html).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mock-llm
  namespace: {{ wk_ns_app }}
  labels:
    app: mock-llm
    workshop.user: {{ lab_id }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mock-llm
  template:
    metadata:
      labels:
        app: mock-llm
    spec:
      containers:
        - name: mock
          image: {{ bonus_tokens_imagen }}
          command: ["/bin/bash", "-c"]
          args:
            - |
              cat > /tmp/server.py <<'PY'
              from http.server import BaseHTTPRequestHandler, HTTPServer
              import json, random
              class H(BaseHTTPRequestHandler):
                  def do_POST(self):
                      length = int(self.headers.get('Content-Length', 0))
                      _ = self.rfile.read(length)
                      tokens = random.randint(15, 60)
                      body = {
                          "id": "chatcmpl-mock",
                          "model": "gpt-mock",
                          "choices": [{
                              "index": 0,
                              "message": {"role": "assistant", "content": "mock response"},
                              "finish_reason": "stop"
                          }],
                          "usage": {"prompt_tokens": tokens//2, "completion_tokens": tokens - tokens//2, "total_tokens": tokens}
                      }
                      self.send_response(200)
                      self.send_header("Content-Type", "application/json")
                      self.end_headers()
                      self.wfile.write(json.dumps(body).encode())
              HTTPServer(("0.0.0.0", 8080), H).serve_forever()
              PY
              python /tmp/server.py
          ports:
            - name: http
              containerPort: 8080
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
---
apiVersion: v1
kind: Service
metadata:
  name: mock-llm
  namespace: {{ wk_ns_app }}
  labels:
    app: mock-llm
    workshop.user: {{ lab_id }}
spec:
  type: ClusterIP
  selector:
    app: mock-llm
  ports:
    - name: http
      port: 8080
      targetPort: http
